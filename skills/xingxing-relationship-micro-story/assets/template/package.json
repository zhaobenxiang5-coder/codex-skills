{
  "name": "__PROJECT_ID__",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "hyperframes lint . > qa/hyperframes-lint.txt",
    "check": "hyperframes check . --at-transitions --strict --json > qa/hyperframes-check.json",
    "inspect": "hyperframes inspect . --samples 15 --at 0.5,3.5,6.8,9.5,13.5,16.2 --at-transitions --strict --json > qa/hyperframes-inspect.json",
    "render": "hyperframes render . --fps 30 --quality high --strict --no-best-effort --skill general-video --output output/__PROJECT_ID__.mp4"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.7.107"
  }
}
